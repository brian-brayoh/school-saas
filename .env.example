# ── Database (Neon) ──────────────────────────────────────
# App connection: POOLED host (has "-pooler"), as the school_app role.
# Must NOT be neondb_owner — that role has BYPASSRLS, which switches off
# tenant isolation. Create school_app first (README → "Database setup").
# Don't add channel_binding=require; Prisma 6 can fail with it.
DATABASE_URL="postgresql://school_app:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Migrations: DIRECT host (no "-pooler"), as the owner role.
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ── Auth.js ──────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
# Required because every school is its own subdomain.
AUTH_TRUST_HOST=true

# ── Domains ──────────────────────────────────────────────
# Locally *.localhost works in Chrome/Edge/Firefox.
ROOT_DOMAIN="localhost:3000"
# Subdomain reserved for the platform admin console.
ADMIN_SUBDOMAIN="admin"
# Optional: extra hostnames mapped to a school code or "admin", for hosts that
# aren't subdomains of ROOT_DOMAIN (e.g. before a wildcard domain is set up, or a
# school's own domain). Comma-separated host=target pairs:
# TENANT_HOSTS="ada-demo.vercel.app=demo,ada-admin.vercel.app=admin"
TENANT_HOSTS=""

# ── M-Pesa ───────────────────────────────────────────────
# Encrypts each school's Daraja keys in the database. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it (saved keys become unreadable).
APP_ENCRYPTION_KEY=""
# Public address Safaricom sends payment notifications to (no trailing slash).
# Must be reachable from the internet: your Vercel domain, or a tunnel for sandbox tests.
PUBLIC_CALLBACK_BASE_URL=""
# The "Simulate payment" card is always on in development; set true to show it in a deployed sandbox.
ENABLE_PAYMENT_SIMULATOR=false

# ── Marketing site ───────────────────────────────────────
# "Book a demo" opens WhatsApp if set (2547XXXXXXXX), else email; hidden if neither.
SALES_WHATSAPP=""
SALES_EMAIL=""

# ── Seed ─────────────────────────────────────────────────
SEED_PLATFORM_ADMIN_EMAIL="admin@example.com"
SEED_PLATFORM_ADMIN_PASSWORD="ChangeMe123!"
