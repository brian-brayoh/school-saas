{
  "name": "school-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:rls": "prisma db execute --file prisma/rls.sql --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx prisma/demo-data.ts",
    "db:setup": "prisma migrate dev --name init && npm run db:rls && npm run db:seed",
    "db:deploy": "prisma migrate deploy && npm run db:rls",
    "rls:check": "tsx scripts/rls-check.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
